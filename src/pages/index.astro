---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const posts = (await getCollection('posts', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [latest, ...rest] = posts;
const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '. ');
// 특별판은 정규 호수를 소모하지 않으므로 번호 대신 '특별판'으로 표시한다
const label = (p: typeof posts[number]) => p.data.special ? '특별판' : `제${p.data.issue}호`;
// 일간 마감은 주간 목록에 섞지 않고 최신 1건만 카드로 보여준다(설계서 2026-09-30 §4.4)
const dailies = (await getCollection('daily', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestDaily = dailies[0];
---
<BaseLayout>
  <main>
    {latest && (
      <section style="padding: 36px 0 8px">
        <div class="issue-label">{label(latest)} · {fmt(latest.data.date)}</div>
        <h2 style="font-size: 26px; margin: 10px 0 12px">
          <a href={`/posts/${latest.id}/`} style="text-decoration:none">{latest.data.title}</a>
        </h2>
        <p style="color: var(--ink-soft)">{latest.data.summary}</p>
      </section>
    )}
    {latestDaily && (
      <section style="padding: 8px 0 20px; border-top: 1px solid var(--rule)">
        <div class="issue-label">최신 일간 마감 · {fmt(latestDaily.data.date)}</div>
        <h3 style="font-size: 18px; margin: 8px 0 6px">
          <a href={`/daily/${latestDaily.id}/`} style="text-decoration:none">{latestDaily.data.title}</a>
        </h3>
        <a href="/daily/" style="font-family: var(--font-sans); font-size: 13px">일간 전체 보기</a>
      </section>
    )}
    {rest.length > 0 && (
    <section>
      <h3 style="font-family: var(--font-sans); font-size: 13px; letter-spacing: 2px; color: var(--muted)">아카이브</h3>
      {rest.map(p => (
        <div class="archive-item">
          <span class="no">{label(p)}</span>
          <a href={`/posts/${p.id}/`} style="text-decoration:none">{p.data.title}</a>
          <span class="date">{fmt(p.data.date)}</span>
        </div>
      ))}
    </section>
    )}
  </main>
</BaseLayout>
