---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const items = (await getCollection('daily', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '. ');
---
<BaseLayout title="일간 마감" description="평일 장 마감 뒤 오늘의 숫자·재료·아이디어 노트">
  <main>
    <section style="padding: 36px 0 8px">
      <h2 style="font-size: 22px; margin: 0 0 8px">일간 마감</h2>
      <p style="color: var(--ink-soft)">평일 장 마감 뒤, 오늘의 숫자와 재료와 내일 볼 것을 짧게 정리합니다.</p>
    </section>
    <section>
      {items.length === 0 && <p style="color: var(--muted)">아직 발행된 일간 글이 없습니다.</p>}
      {items.map(p => (
        <div class="archive-item">
          <span class="no">일간</span>
          <a href={`/daily/${p.id}/`} style="text-decoration:none">{p.data.title}</a>
          <span class="date">{fmt(p.data.date)}</span>
        </div>
      ))}
    </section>
  </main>
</BaseLayout>
