---
import { SITE } from '../config';
const g = SITE.giscus;
const enabled = g.repo !== '' && g.repoId !== '' && g.categoryId !== '';
---
{enabled && (
  <section style="margin-top: 48px; border-top: 1px solid var(--rule); padding-top: 24px">
    <h3 style="font-family: var(--font-sans); font-size: 13px; letter-spacing: 2px; color: var(--muted)">댓글</h3>
    <script src="https://giscus.app/client.js"
      data-repo={g.repo} data-repo-id={g.repoId}
      data-category={g.category} data-category-id={g.categoryId}
      data-mapping="pathname" data-strict="0" data-reactions-enabled="1"
      data-emit-metadata="0" data-input-position="top" data-theme="light"
      data-lang="ko" crossorigin="anonymous" async></script>
  </section>
)}
